# Runtime data and generated research artifacts
data/
reports/
logs/
runtime/
artifacts/
docs/evidence/

# Permit only a version-bound comprehensive stage report under reports/.
# Keep the reports parent traversable so Git can see the narrow exception below.
!reports/
reports/*
!reports/stage/
reports/stage/*
!reports/stage/V4_*_COMPREHENSIVE_TEST_REPORT_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_R[0-9].md
reports/audits/
reports/r[0-9]*/
reports/v4_*/

# Large versioned R4/R5 evidence remains in the ignored local artifact store.
# Commit only hashes, counts, bounded samples, validation reports, and receipts.
data/v4/historical_universe/v4_01_reconstructed_a_stock_universe_R4_20260925.jsonl.gz
data/v4/artifact_store/v4_01/
reports/v4_01/canonical_source_selection_R4_20260925.json
reports/v4_01/baostock_lifecycle_facts_R4_20260925.json
reports/v4_01/baostock_lifecycle_probe_R4_20260925.json
reports/v4_01/v4_01_security_inventory_*.csv

