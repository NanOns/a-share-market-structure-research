    "normalized_fields": {
      "code": "security_id",
      "name": "security_name",
      "latest": "price",
      "change_rate": "ret1",
      "amount": "amount",
      "order_amount": "seal_amount",
      "currency_value": "float_market_cap",
      "turnover_rate": "turnover",
      "open_num": "open_count",
      "reason_type": "source_reason",
      "first_limit_up_time": "first_limit_up_time",
      "last_limit_up_time": "last_limit_up_time"
    },
    "conversion_status": "UNRESOLVED_UNTIL_CURRENT_PROBE",
    "rules": [
      "change_rate scale must be confirmed from a current sample",
      "Unix second zero maps to NULL, not 1970-01-01",
      "seal_amount is not amount and float_market_cap is not amount",
      "reason_type is source topic/reason text, not an exchange-official reason",
      "height sorting uses source height when present; no local synthetic height"
    ]
  },
  "probe_persistence": {
