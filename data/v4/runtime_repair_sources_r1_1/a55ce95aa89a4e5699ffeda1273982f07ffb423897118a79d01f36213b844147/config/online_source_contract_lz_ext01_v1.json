    "complete-page or explicit pagination coverage evidence",
    "source failure and empty response fail closed"
  ],
  "request": {
    "method": "GET",
    "endpoint_template": "https://data.10jqka.com.cn/dataapi/limit_up/limit_up_pool?page={page}&limit={limit}&field={fields}&filter=HS,GEM2STAR&order_field=330323&order_type=0&date={YYYYMMDD}",
    "probe_page": 1,
