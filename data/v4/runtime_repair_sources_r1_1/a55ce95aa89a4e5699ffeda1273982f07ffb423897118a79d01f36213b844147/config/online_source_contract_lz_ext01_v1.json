    "probe_trade_date": "20260911",
    "field_parameter_mode": "NAMED_FIELD_CANDIDATE_ONLY",
    "field_codes": null,
    "field_codes_status": "UNRESOLVED",
    "field_candidates": ["code", "name", "latest", "change_rate", "amount", "order_amount", "currency_value", "turnover_rate", "open_num", "reason_type", "first_limit_up_time", "last_limit_up_time"],
    "filter": "HS,GEM2STAR",
    "order_field": "330323",
    "order_type": 0,
    "date_semantics": "YYYYMMDD_ASIA_SHANGHAI",
    "timeout_seconds": 8,
    "max_response_bytes": 2000000,
    "retries": 0,
    "credentials_used": false
  },
  "normalization": {
