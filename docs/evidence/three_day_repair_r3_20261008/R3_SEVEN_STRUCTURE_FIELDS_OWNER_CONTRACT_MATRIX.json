  "V4_12_pullback_rules": {
    "op": "ordered_select",
    "otherwise": {
      "enum": "NOT_PULLBACK"
    },
    "rules": [
      {
        "then": {
          "enum": "NOT_PULLBACK"
        },
        "when": {
          "args": [
            {
              "field": "prior_valid_event"
            }
          ],
          "op": "not"
        }
      },
      {
        "then": {
          "enum": "PULLBACK_FAILED"
        },
        "when": {
          "args": [
            {
              "args": [
                {
                  "field": "prior_support_state"
                },
                {
                  "enum": "BROKEN"
                }
              ],
              "op": "eq"
            },
            {
              "args": [
                {
                  "field": "prior_support_state"
                },
                {
                  "enum": "INVALIDATED"
                }
              ],
              "op": "eq"
            }
          ],
          "op": "or"
        }
      },
      {
        "then": {
          "enum": "UNKNOWN"
        },
        "when": {
          "args": [
            {
              "field": "evaluable"
            }
          ],
          "op": "not"
        }
      },
      {
        "then": {
          "enum": "PULLBACK_HELD"
        },
        "when": {
          "args": [
            {
              "field": "support_today"
            },
            {
              "enum": "HELD_CONFIRMED"
            }
          ],
          "op": "eq"
        }
      },
      {
        "then": {
          "enum": "PULLBACK_RECLAIMED"
        },
        "when": {
          "args": [
            {
              "args": [
                {
                  "field": "support_today"
                },
                {
                  "enum": "RECLAIMED"
                }
              ],
              "op": "eq"
            },
            {
              "args": [
                {
                  "field": "support_today"
                },
                {
                  "enum": "HELD_TENTATIVE"
                }
              ],
              "op": "eq"
            }
          ],
          "op": "or"
        }
      },
      {
        "then": {
          "enum": "PULLBACK_TO_MA"
        },
        "when": {
          "args": [
            {
              "field": "touch"
            },
            {
              "args": [
                {
                  "args": [
                    {
                      "field": "anchor_type"
                    },
                    {
                      "enum": "MA20_DYNAMIC"
                    }
                  ],
                  "op": "eq"
                },
                {
                  "args": [
                    {
                      "field": "anchor_type"
                    },
                    {
                      "enum": "MA60_DYNAMIC"
                    }
                  ],
                  "op": "eq"
                }
              ],
              "op": "or"
            }
          ],
          "op": "and"
        }
      },
      {
        "then": {
          "enum": "PULLBACK_TO_IMPULSE"
        },
        "when": {
          "args": [
            {
              "field": "touch"
            },
            {
              "args": [
                {
                  "args": [
                    {
                      "field": "anchor_type"
                    },
                    {
                      "enum": "BULLISH_IMPULSE_BODY"
                    }
                  ],
                  "op": "eq"
                },
                {
                  "args": [
                    {
                      "field": "anchor_type"
                    },
                    {
                      "enum": "BULLISH_IMPULSE_LOW"
                    }
                  ],
                  "op": "eq"
                }
              ],
              "op": "or"
            }
          ],
          "op": "and"
        }
      },
      {
        "then": {
          "enum": "PULLBACK_TO_BREAKOUT"
        },
        "when": {
          "field": "touch"
        }
      },
      {
        "then": {
          "enum": "PULLBACK_IN_PROGRESS"
        },
        "when": {
          "field": "post_peak_drawdown"
        }
      }
    ],
    "unknown": "STOP_WITH_UNKNOWN_BEFORE_LOWER_PRIORITY"
  },
  "V4_12_recovery_rules": {
    "op": "ordered_select",
    "otherwise": {
      "enum": "NONE"
    },
    "rules": [
      {
        "then": {
          "enum": "RECOVERY_FAILED"
        },
        "when": {
          "field": "prior_recovery_failed"
        }
      },
      {
        "then": {
          "enum": "RECOVERY_CONFIRMED"
        },
        "when": {
          "args": [
            {
              "field": "prior_recovery_exists"
            },
            {
              "args": [
                {
                  "field": "post_creation_market_sessions"
                },
                {
                  "parameter_id": "earliest_anchor_test_sessions"
                }
              ],
              "op": "ge"
            },
            {
              "args": [
                {
                  "field": "recovery_held_count"
                },
                {
                  "parameter_id": "acceptance_consecutive_sessions"
                }
              ],
              "op": "ge"
            }
          ],
          "op": "and"
        }
      },
      {
        "then": {
          "enum": "ANCHOR_RECLAIM"
        },
        "when": {
          "args": [
            {
              "field": "prior_valid_event"
            },
            {
              "args": [
                {
                  "field": "post_creation_market_sessions"
                },
                {
                  "parameter_id": "earliest_anchor_test_sessions"
                }
              ],
              "op": "ge"
            },
            {
              "field": "eod_reclaim"
            }
          ],
          "op": "and"
        }
      },
      {
        "then": {
          "enum": "MA20_RECLAIM"
        },
        "when": {
          "field": "ma20_reclaim"
        }
      },
      {
        "then": {
          "enum": "RELATIVE_RECOVERY"
        },
        "when": {
          "field": "relative_recovery"
        }
      },
      {
        "then": {
          "enum": "BOUNCE_ONLY"
        },
        "when": {
          "args": [
            {
              "field": "ret1"
            },
            {
              "math_constant": "ZERO"
            }
          ],
          "op": "gt"
        }
      }
    ],
    "unknown": "STOP_WITH_UNKNOWN_BEFORE_LOWER_PRIORITY"
  },
