{
  "V4_12_breakout_rules": {
    "op": "ordered_select",
    "otherwise": {
      "enum": "NO_BREAKOUT"
    },
    "rules": [
      {
        "then": {
          "enum": "UNKNOWN"
        },
        "when": {
          "args": [
            {
              "field": "evaluable"
            }
          ],
          "op": "not"
        }
      },
      {
        "then": {
          "enum": "FAILED_BREAKOUT"
        },
        "when": {
          "args": [
            {
              "field": "prior_breakout_exists"
            },
            {
              "args": [
                {
                  "args": [
                    {
                      "field": "prior_support_state"
                    },
                    {
                      "enum": "BROKEN"
                    }
                  ],
                  "op": "eq"
                },
                {
                  "args": [
                    {
                      "field": "prior_support_state"
                    },
                    {
                      "enum": "INVALIDATED"
                    }
                  ],
                  "op": "eq"
                }
              ],
              "op": "or"
            }
          ],
          "op": "and"
        }
      },
      {
        "then": {
          "enum": "BREAKOUT_ACCEPTED"
        },
        "when": {
          "args": [
            {
              "field": "prior_breakout_exists"
            },
            {
              "args": [
                {
                  "field": "post_creation_market_sessions"
                },
                {
                  "parameter_id": "earliest_anchor_test_sessions"
                }
              ],
              "op": "ge"
            },
            {
              "args": [
                {
                  "args": [
                    {
                      "field": "support_today"
                    },
                    {
                      "enum": "HELD_CONFIRMED"
                    }
                  ],
                  "op": "eq"
                },
                {
                  "args": [
                    {
                      "field": "held_count"
                    },
                    {
                      "parameter_id": "acceptance_consecutive_sessions"
                    }
                  ],
                  "op": "ge"
                }
              ],
              "op": "or"
            }
          ],
          "op": "and"
        }
      },
      {
        "then": {
          "enum": "TESTING"
        },
        "when": {
          "args": [
            {
              "field": "prior_breakout_exists"
            },
            {
              "args": [
                {
                  "field": "post_creation_market_sessions"
                },
                {
                  "parameter_id": "earliest_anchor_test_sessions"
                }
              ],
              "op": "ge"
            },
            {
              "field": "touch"
            }
          ],
          "op": "and"
        }
      },
      {
        "then": {
          "enum": "BREAKOUT_TENTATIVE"
        },
        "when": {
          "field": "prior_breakout_exists"
        }
      },
      {
        "then": {
          "enum": "BREAKOUT_TENTATIVE"
        },
        "when": {
          "field": "breakout_trigger"
        }
      },
      {
        "then": {
          "enum": "APPROACHING"
        },
        "when": {
          "args": [
            {
              "field": "near_high20_state"
            },
            {
              "enum": "NEAR"
            }
          ],
          "op": "eq"
        }
      }
    ],
    "unknown": "STOP_WITH_UNKNOWN_BEFORE_LOWER_PRIORITY"
  },
