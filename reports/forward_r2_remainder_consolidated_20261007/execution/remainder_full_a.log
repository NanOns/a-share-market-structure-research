            'WP-A12-V4-02-STATUS-ST-AUTHORITY': 'BLOCKED_R2_REAL_DATED_OWNER_SEMANTICS',
            'WP-A01-DM01': 'PARTIAL_ENGINEERING_PASS_FINAL_ALL_NINE_BLOCKED'}
